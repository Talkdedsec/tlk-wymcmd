<Window x:Class="Wymcmd.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Wymcmd.Converters"
        xmlns:loc="clr-namespace:Wymcmd.Core.Localization"
        xmlns:vm="clr-namespace:Wymcmd.ViewModels"
        Title="wymcmd"
        Width="1280" Height="800" MinWidth="900" MinHeight="560"
        Background="{StaticResource Background}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:VerdictConverter x:Key="Verdict" />
        <conv:RiskBrushConverter x:Key="RiskBrush" />
        <conv:WindowStateTextConverter x:Key="WindowText" />
        <conv:SignatureTextConverter x:Key="SignatureText" />
        <conv:SourceTextConverter x:Key="SourceText" />
        <conv:TimeAgoConverter x:Key="TimeAgo" />
        <conv:NullToCollapsedConverter x:Key="HideEmpty" />
        <conv:BoolToWatchTextConverter x:Key="WatchText" />
        <conv:EmptyToVisibleConverter x:Key="WhenEmpty" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header -->
        <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="18,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/brand/logo.png" Height="34" Width="34" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="wymcmd" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:T app.subtitle}" Style="{StaticResource Label}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ComboBox Width="104" ItemsSource="{Binding Languages}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />
                    <Button Content="{loc:T gui.stats_button}" Click="OnStatsClick" Margin="8,0,0,0" />
                    <Button Content="{loc:T gui.sources_button}" Click="OnSourcesClick" Margin="8,0,0,0" />
                    <Button Content="{loc:T gui.refresh}" Command="{Binding RefreshCommand}" Margin="8,0,0,0" />
                    <Button Content="{Binding Watching, Converter={StaticResource WatchText}}"
                            Command="{Binding ToggleWatchCommand}" Style="{StaticResource AccentButton}" Margin="8,0,0,0" />
                    <Button Content="{loc:T gui.panic}" Command="{Binding PanicCommand}" Margin="8,0,0,0"
                            Foreground="{StaticResource Danger}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- filters -->
        <Border Grid.Row="1" Background="{StaticResource Background}" Padding="18,10">
            <StackPanel Orientation="Horizontal">
                <TextBox Width="280" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                <CheckBox Content="{loc:T gui.filter_console}" IsChecked="{Binding ConsoleOnly}" Margin="14,0,0,0" />
                <CheckBox Content="{loc:T gui.filter_hidden}" IsChecked="{Binding HiddenOnly}" Margin="14,0,0,0" />
                <CheckBox Content="{loc:T gui.filter_unsigned}" IsChecked="{Binding UnsignedOnly}" Margin="14,0,0,0" />
                <TextBlock Text="{loc:T gui.filter_risk}" Style="{StaticResource Label}" Margin="18,0,6,0" VerticalAlignment="Center" />
                <Slider Width="120" Minimum="0" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True"
                        Value="{Binding MinRisk}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding MinRisk}" Style="{StaticResource Label}" Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- events + detail -->
        <Grid Grid.Row="2" Margin="12,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="440" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{loc:T gui.empty_list}" Style="{StaticResource Label}"
                       TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding Events.Count, Converter={StaticResource WhenEmpty}}" />

            <ListView Grid.Column="0" ItemsSource="{Binding Events}" SelectedItem="{Binding Selected}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Rectangle Grid.Column="0" Width="3" RadiusX="2" RadiusY="2"
                                       Fill="{Binding Risk, Converter={StaticResource RiskBrush}}" Margin="0,1,8,1" />

                            <TextBlock Grid.Column="1" Text="{Binding StartTime, StringFormat=HH:mm:ss}"
                                       Style="{StaticResource Mono}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ImageName}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Window, Converter={StaticResource WindowText}}"
                                           Style="{StaticResource Label}" />
                            </StackPanel>

                            <TextBlock Grid.Column="3" Text="{Binding Converter={StaticResource Verdict}}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0" />

                            <Border Grid.Column="4" Background="{Binding Risk, Converter={StaticResource RiskBrush}}"
                                    CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Risk}" Foreground="#FF05070A" FontWeight="SemiBold" FontSize="11" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <GridSplitter Grid.Column="1" Width="4" Background="Transparent" HorizontalAlignment="Stretch" />

            <Border Grid.Column="2" Background="{StaticResource Surface}" CornerRadius="8" Padding="16"
                    BorderBrush="{StaticResource Border}" BorderThickness="1" Margin="0,0,0,12">
                <Grid>
                    <TextBlock Text="{loc:T gui.empty_detail}" Style="{StaticResource Label}"
                               TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Selected, Converter={StaticResource WhenEmpty}}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding Selected, Converter={StaticResource HideEmpty}}">
                    <StackPanel DataContext="{Binding Selected}">
                        <TextBlock Text="{Binding ImageName}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Converter={StaticResource Verdict}}" TextWrapping="Wrap"
                                   Foreground="{StaticResource Mint}" Margin="0,4,0,14" />

                        <TextBlock Text="{loc:T why.when}" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding StartTime, StringFormat=F}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding StartTime, Converter={StaticResource TimeAgo}}"
                                   Style="{StaticResource Label}" Margin="0,0,0,12" />

                        <TextBlock Text="{loc:T why.command}" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding CommandLine, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                 FontFamily="{StaticResource MonoFont}" Margin="0,0,0,12" />

                        <StackPanel Visibility="{Binding DecodedCommand, Converter={StaticResource HideEmpty}}">
                            <TextBlock Text="{loc:T why.decoded}" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding DecodedCommand, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                     FontFamily="{StaticResource MonoFont}" Margin="0,0,0,12" />
                        </StackPanel>

                        <TextBlock Text="{loc:T why.image}" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding ImagePath}" TextWrapping="Wrap" Margin="0,0,0,12" />

                        <TextBlock Text="{loc:T why.source}" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding Source, Converter={StaticResource SourceText}}" TextWrapping="Wrap" Margin="0,0,0,12" />

                        <TextBlock Text="{loc:T why.signature}" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding Signature, Converter={StaticResource SignatureText}}" Margin="0,0,0,12" />

                        <TextBlock Text="{loc:T why.user}" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding UserName}" Margin="0,0,0,12" />

                        <TextBlock Text="{loc:T why.chain}" Style="{StaticResource Label}" />
                        <ItemsControl ItemsSource="{Binding Chain}" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource Mono}">
                                        <Run Text="{Binding ImageName, Mode=OneWay}" />
                                        <Run Text="{Binding Pid, Mode=OneWay, StringFormat=({0})}" Foreground="{StaticResource Muted}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{loc:T why.risk}" Style="{StaticResource Label}" />
                        <ItemsControl ItemsSource="{Binding RiskFactors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,1">
                                        <Run Text="{Binding Weight, Mode=OneWay, StringFormat=+{0}}" Foreground="{StaticResource Warn}" />
                                        <Run Text=" " />
                                        <Run Text="{Binding Key, Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- status -->
        <Border Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="18,8">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding CaptureText}" Style="{StaticResource Label}" />
                    <TextBlock Text="  ·  " Style="{StaticResource Label}" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Label}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:T gui.open_location}" Command="{Binding OpenLocationCommand}" />
                    <Button Content="{loc:T gui.kill}" Command="{Binding KillSelectedCommand}" Margin="8,0,0,0" />
                    <Button Content="{loc:T gui.kill_tree}" Command="{Binding KillTreeSelectedCommand}" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
