<Window x:Class="Wymcmd.Views.StatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Wymcmd.Core.Localization"
        Title="Why My CMD Opened"
        Width="860" Height="700"
        Background="{StaticResource Background}"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <DataTemplate x:Key="BarRow">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="58" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Share, Mode=OneWay}"
                                 Height="24" Background="{StaticResource SurfaceRaised}"
                                 Foreground="{StaticResource Mint}" BorderThickness="0" Opacity="0.35" />
                    <TextBlock Text="{Binding Label}" Margin="9,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" FontSize="12" />
                </Grid>

                <TextBlock Grid.Column="1" Text="{Binding Count}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Style="{StaticResource Label}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{loc:T stats.title}" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
            <StackPanel>
                <TextBlock Text="{loc:T stats.launchers}" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding Launchers}" ItemTemplate="{StaticResource BarRow}" Margin="0,0,0,18" />

                <TextBlock Text="{loc:T stats.images}" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding Images}" ItemTemplate="{StaticResource BarRow}" Margin="0,0,0,18" />

                <TextBlock Text="{loc:T stats.hours}" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding Hours}" ItemTemplate="{StaticResource BarRow}" Margin="0,0,0,18" />

                <TextBlock Text="{loc:T stats.commands}" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding Commands}" ItemTemplate="{StaticResource BarRow}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
