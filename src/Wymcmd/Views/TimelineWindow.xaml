<Window x:Class="Wymcmd.Views.TimelineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Wymcmd.Converters"
        xmlns:loc="clr-namespace:Wymcmd.Core.Localization"
        Title="Why My CMD Opened"
        Width="1040" Height="680"
        Background="{StaticResource Background}"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <conv:VerdictConverter x:Key="Verdict" />
        <conv:RiskBrushConverter x:Key="RiskBrush" />
        <conv:WindowStateTextConverter x:Key="WindowText" />
        <conv:SourceTextConverter x:Key="SourceText" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{loc:T gui.timeline_title}" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SourceHint}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="{loc:T gui.timeline_moment}" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Width="150" Text="{Binding Moment, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="{loc:T gui.timeline_radius}" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="16,0,8,0" />
            <TextBox Width="80" Text="{Binding Radius, UpdateSourceTrigger=PropertyChanged}" />

            <CheckBox Content="{loc:T gui.filter_console}" IsChecked="{Binding ConsoleOnly}" Margin="16,0,0,0" />

            <Button Content="{loc:T gui.timeline_show}" Command="{Binding LoadCommand}"
                    Style="{StaticResource AccentButton}" Margin="16,0,0,0" IsDefault="True" />
        </StackPanel>

        <ListView Grid.Row="2" ItemsSource="{Binding Events}" SelectedItem="{Binding Selected}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Rectangle Grid.Column="0" Width="3" RadiusX="2" RadiusY="2"
                                   Fill="{Binding Risk, Converter={StaticResource RiskBrush}}" Margin="0,1,8,1" />

                        <TextBlock Grid.Column="1" Text="{Binding StartTime, StringFormat=HH:mm:ss}"
                                   Style="{StaticResource Mono}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ImageName}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Window, Converter={StaticResource WindowText}}" Style="{StaticResource Label}" />
                        </StackPanel>

                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="8,0">
                            <TextBlock Text="{Binding Converter={StaticResource Verdict}}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding CommandLine}" Style="{StaticResource Label}"
                                       FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Border Grid.Column="4" Background="{Binding Risk, Converter={StaticResource RiskBrush}}"
                                CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Risk}" Foreground="#FF05070A" FontWeight="SemiBold" FontSize="11" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="{Binding Message}" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <TextBlock Text="{loc:T gui.timeline_working}" Foreground="{StaticResource Mint}" Margin="12,0,0,0"
                       VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Busy}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
