<Window x:Class="Wymcmd.Views.SourcesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Wymcmd.Core.Localization"
        Title="Why My CMD Opened"
        Width="620" Height="560"
        Background="{StaticResource Background}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{loc:T gui.sources_title}" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="{loc:T gui.sources_hint}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{loc:T gui.checking}" VerticalAlignment="Top">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Label}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Busy}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource Surface}" CornerRadius="6" Padding="12,9" Margin="0,0,0,6"
                            BorderBrush="{StaticResource Border}" BorderThickness="1">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Label}" />
                            </StackPanel>
                            <TextBlock Text="{Binding StateText}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="Ok">
                                                <Setter Property="Foreground" Value="{StaticResource Mint}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Degraded">
                                                <Setter Property="Foreground" Value="{StaticResource Warn}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Missing">
                                                <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="{Binding BlackBoxText}" Style="{StaticResource Label}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ServiceText}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0" />
            <TextBlock Text="{Binding Message}" Foreground="{StaticResource Mint}" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <WrapPanel Grid.Row="3" Margin="0,16,0,0" IsEnabled="{Binding Idle}">
            <Button Content="{loc:T gui.enable_sources}" Command="{Binding EnableSourcesCommand}"
                    Style="{StaticResource AccentButton}" Margin="0,0,8,8" />
            <Button Content="{loc:T gui.toggle_blackbox}" Command="{Binding ToggleBlackBoxCommand}" Margin="0,0,8,8" />
            <Button Content="{loc:T gui.toggle_service}" Command="{Binding ToggleServiceCommand}" Margin="0,0,8,8" />
            <Button Content="{loc:T gui.refresh}" Command="{Binding RefreshCommand}" Margin="0,0,8,8" />
            <Button Content="{loc:T gui.remove_everything}" Command="{Binding RemoveEverythingCommand}"
                    Foreground="{StaticResource Danger}" Margin="0,0,0,8" />
        </WrapPanel>
    </Grid>
</Window>
